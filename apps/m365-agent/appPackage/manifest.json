{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "id": "${{TEAMS_APP_ID}}",
  "version": "1.0.0",
  "developer": {
    "name": "XDCE Prototype Agent",
    "websiteUrl": "https://github.com/fedep98/xdce-prototype-agent",
    "privacyUrl": "https://github.com/fedep98/xdce-prototype-agent/blob/fedep98-xdce-prototype-agent-mvp/docs/security.md",
    "termsOfUseUrl": "https://github.com/fedep98/xdce-prototype-agent/blob/fedep98-xdce-prototype-agent-mvp/docs/limitations.md"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "XDCE Prototype${{APP_NAME_SUFFIX}}",
    "full": "XDCE Prototype Agent for Microsoft 365 Copilot"
  },
  "description": {
    "short": "Crea prototipi con i componenti verificati della libreria XDCE.",
    "full": "Agente Microsoft 365 Copilot per definire e validare prototipi pagina usando esclusivamente componenti e opzioni verificati dal catalogo XDCE."
