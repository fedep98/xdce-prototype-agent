{
  "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.2/schema.json",
  "schema_version": "v2.2",
  "name_for_human": "XDCE Prototype API",
  "description_for_human": "Catalogo verificato e generazione di prototipi XDCE.",
  "namespace": "xdcePrototype",
  "functions": [
    {
      "name": "listComponents",
      "description": "Elenca i componenti XDCE verificati."
    },
    {
      "name": "generatePrototype",
      "description": "Genera JSON canonico o domande strutturate per i requisiti mancanti."
    },
    {
      "name": "validatePrototype",
      "description": "Valida il JSON canonico del prototipo."
    }
  ],
  "runtimes": [
    {
      "type": "OpenApi",
      "auth": { "type": "None" },
      "spec": { "url": "https://REPLACE_WITH_DEPLOYED_HOST/openapi.yaml" },
      "run_for_functions": ["listComponents", "generatePrototype", "validatePrototype"]
    }
  ],
  "capabilities": {
    "conversation_starters": [
      { "text": "Quali componenti XDCE posso usare?" }
    ]
  }
}
